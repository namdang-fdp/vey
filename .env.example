# Optional local port and credential overrides for docker compose.
VEY_POSTGRES_PORT=5432
VEY_POSTGRES_PASSWORD=vey_local_password
VEY_REDIS_PORT=6379
VEY_KAFKA_PORT=9092
VEY_MINIO_PORT=9000
VEY_MINIO_CONSOLE_PORT=9001
VEY_MINIO_ACCESS_KEY=vey-local
VEY_MINIO_SECRET_KEY=vey-local-password

# Spring trust bridge (public identity origin; never a shared signing secret).
VEY_AUTH_ISSUER=http://localhost:3000
VEY_AUTH_JWKS_URI=http://localhost:3000/api/auth/jwks
VEY_AUTH_AUDIENCE=http://localhost:3000
VEY_AUTH_SESSION_TTL=7d
VEY_AUTH_COOKIE_SECURE=false

# Opt in only for local API documentation.
VEY_API_DOCS_ENABLED=true
